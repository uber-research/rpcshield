# gazelle:gomock interfaces=FSRenamer,GoPathWrapper library=github.com/uber-research/rpcshield/go/bazel extra_imports=github.com/uber-research/rpcshield/go/common/utils,go.uber.org/mock/gomock
# keep
load("@io_bazel_rules_go//extras:gomock.bzl", "gomock")
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "bazel.go",
        "cgo.go",
        "importcomment.go",
        "inferfaces.go",
        "rename.go",
        "serverlessfix.go",
    ],
    importpath = "github.com/uber-research/rpcshield/go/bazel",
    visibility = ["//visibility:public"],
    deps = [
        "//config:go_default_library",
        "//common/utils:go_default_library",
        "@org_uber_go_zap//:go_default_library",
    ],
)

gomock(
    name = "bazel_gomock",
    out = "bazelmock.go",
    mockgen_tool = "@org_uber_go_mock//mockgen",
    package = "bazelmock",
    self_package = "mock/github.com/uber-research/rpcshield/go/bazel/bazelmock",
    source = "inferfaces.go",
    source_importpath = "github.com/uber-research/rpcshield/go/bazel",
)

go_library(
    name = "go_bazel_gomock_library",
    srcs = ["bazelmock.go"],
    importpath = "mock/github.com/uber-research/rpcshield/go/bazel/bazelmock",
    visibility = ["//visibility:public"],
    deps = [
        "//common/utils:go_default_library",
        "@org_uber_go_mock//gomock:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = ["rename_test.go"],
    embed = [":go_default_library"],
    deps = [
        "//common/utils:go_default_library",
        "@com_github_stretchr_testify//assert:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
        "@org_uber_go_zap//zaptest:go_default_library",
    ],
)
