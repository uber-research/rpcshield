load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_path")

# app.go carries the //go:build cff tag and is the cff source-of-truth; it is NOT compiled
# directly. app_gen.go is the checked-in ground truth for what the CURRENT internal `cff` codegen
# tool actually emits for a single cff.Parallel with multiple mixed task/slice arguments (including
# a bound-method task) and for two cff.Slice arguments over the same element type -- captured via
# `bazel build --output_groups=go_generated_srcs` against a throwaway internal fixture
# (go.uber.org/cff/internal/tests/mixedparallel) and adapted here (see app_gen.go's doc
# comment for the exact provenance and shape).
# keep
go_library(
    name = "go_default_library",
    srcs = ["app_gen.go"],
    importpath = "github.com/uber-research/rpcshield/go/exampleapps/cffappmixedparallel",
    visibility = ["//visibility:public"],
    deps = [
        "@org_uber_go_cff//:go_default_library",
    ],
)

go_binary(
    name = "cffappmixedparallel",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

# graph/cffenricher_test.go (@rpcshield_ext) uses this example as test input.
go_path(
    name = "cffappmixedparallel-anal",
    testonly = True,
    include_data = False,
    visibility = ["//visibility:public"],
    deps = [":cffappmixedparallel"],
)
