# keep
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:exclude **/testdata

go_library(
    name = "go_default_library",
    srcs = ["mapper.go"],
    importpath = "github.com/uber-research/rpcshield/go/common/mapper",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_x_tools//go/packages:go_default_library",
        "@org_golang_x_tools//go/ssa:go_default_library",
        "@org_golang_x_tools//go/ssa/ssautil:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    size = "large",  # Loads and type-checks testdata packages via the Go toolchain; default timeout is too tight on a cold GOCACHE.
    srcs = ["mapper_test.go"],
    data = [
        "//common/mapper:testdata",
        "@go_sdk//:files",
    ],
    embed = [":go_default_library"],
    deps = [
        "//loader:go_default_library",
        "@com_github_stretchr_testify//assert:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
        "@org_golang_x_tools//go/ssa:go_default_library",
        "@org_golang_x_tools//go/ssa/ssautil:go_default_library",
    ],
)

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//visibility:public"],
)
